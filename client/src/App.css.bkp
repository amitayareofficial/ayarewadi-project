* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html,
body,
#root {
  width: 100%;
  overflow-x: hidden;
  font-family: Arial, sans-serif;
  background: #f7f5f2;
}

.website {
  width: 100%;
}

/* NAVBAR */

.navbar {
  position: absolute;
  top: 0;
  left: 0;

  width: 100%;

  display: flex;
  justify-content: space-between;
  align-items: center;

  padding: 32px 80px;

  z-index: 100;
}

.logo {
  color: white;
  font-size: 34px;
  font-weight: 700;
  letter-spacing: 1px;
}

.nav-links {
  display: flex;
  gap: 45px;
  list-style: none;
}

.nav-links li {
  color: white;
  font-size: 16px;
  cursor: pointer;
  transition: 0.3s;
}

.nav-links li:hover {
  opacity: 0.7;
}

/* HERO */

.hero {
  position: relative;

  width: 100%;
  height: 100vh;

  background-image:
    linear-gradient(
      rgba(0,0,0,0.35),
      rgba(0,0,0,0.35)
    ),
    url("https://images.unsplash.com/photo-1506744038136-46273834b3fb");

  background-size: cover;
  background-position: center;

  display: flex;
  align-items: center;

  padding-left: 120px;
}

.hero-content {
  position: relative;
  z-index: 2;

  max-width: 720px;
  color: white;
}

.hero-small-text {
  letter-spacing: 5px;
  font-size: 15px;
  margin-bottom: 25px;
}

.hero-content h1 {
  font-size: 110px;
  line-height: 1;
  margin-bottom: 35px;
  font-weight: 700;
}

.hero-description {
  font-size: 20px;
  line-height: 1.8;
  max-width: 600px;
  margin-bottom: 45px;
}

.hero-content button {
  padding: 18px 40px;
  border: none;
  background: #2e5c3e;
  color: white;
  border-radius: 6px;
  font-size: 18px;
  cursor: pointer;
  transition: 0.3s;
}

.hero-content button:hover {
  background: #21452d;
}

/* COMMON */

.section-tag {
  font-size: 14px;
  letter-spacing: 4px;
  color: #777;
  margin-bottom: 20px;
}

/* ABOUT */

.about-section {
  width: 100%;

  display: flex;
  align-items: center;
  justify-content: center;

  gap: 100px;

  padding: 140px 100px;

  background: white;
}

.about-image img {
  width: 560px;
  height: 700px;
  object-fit: cover;
  border-radius: 12px;
}

.about-content {
  max-width: 600px;
}

.about-content h2 {
  font-size: 60px;
  line-height: 1.2;
  margin-bottom: 30px;
  color: #111;
}

.about-content p {
  font-size: 19px;
  line-height: 1.9;
  color: #555;
}

/* EVENTS */

.events-section {
  width: 100%;

  padding: 140px 100px;

  background: #f7f5f2;
}

.events-header {
  margin-bottom: 70px;
}

.events-header h2 {
  font-size: 60px;
  line-height: 1.2;
  color: #111;
}

.event-grid {
  display: grid;

  grid-template-columns:
    repeat(auto-fit, minmax(300px, 1fr));

  gap: 35px;
}

.event-card {
  background: white;

  padding: 45px;

  border-radius: 14px;

  box-shadow:
    0 10px 30px rgba(0,0,0,0.06);

  transition: 0.3s;
}

.event-card:hover {
  transform: translateY(-10px);
}

.event-card h3 {
  font-size: 28px;
  margin-bottom: 20px;
  color: #1f3d29;
}

.event-card p {
  line-height: 1.8;
  color: #666;
}

/* EXPERIENCE */

.experience-section {
  width: 100%;

  display: flex;
  justify-content: space-between;

  gap: 100px;

  padding: 140px 100px;

  background: white;
}

.experience-left {
  width: 40%;
}

.experience-left h2 {
  font-size: 60px;
  line-height: 1.2;
  margin-bottom: 30px;
}

.experience-left p {
  font-size: 18px;
  line-height: 1.9;
  color: #555;
}

.experience-right {
  width: 60%;

  display: grid;

  grid-template-columns:
    repeat(2, 1fr);

  gap: 30px;
}

.experience-card {
  height: 260px;

  border-radius: 14px;

  background-image:
    linear-gradient(
      rgba(0,0,0,0.35),
      rgba(0,0,0,0.35)
    ),
    url("https://images.unsplash.com/photo-1470770841072-f978cf4d019e");

  background-size: cover;
  background-position: center;

  display: flex;
  align-items: end;

  padding: 30px;

  color: white;

  transition: 0.3s;
}

.experience-card:hover {
  transform: scale(1.03);
}

.experience-card h3 {
  font-size: 28px;
}

/* MOBILE */

@media (max-width: 768px) {

  .navbar {
    padding: 20px;
  }

  .nav-links {
    display: none;
  }

  .hero {
    padding: 20px;
  }

  .hero-content h1 {
    font-size: 58px;
  }

  .hero-description {
    font-size: 16px;
  }

  .about-section,
  .experience-section {
    flex-direction: column;
    padding: 70px 20px;
  }

  .about-image img {
    width: 100%;
    height: auto;
  }

  .about-content h2,
  .events-header h2,
  .experience-left h2 {
    font-size: 42px;
  }

  .events-section {
    padding: 70px 20px;
  }

  .experience-left,
  .experience-right {
    width: 100%;
  }

  .experience-right {
    grid-template-columns: 1fr;
  }
}
